#. Key:	Rafi01Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1357)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1357)
msgctxt "MishpachaGreybox,Rafi01Title"
msgid "Collection at the Market"
msgstr "גבייה בשוק"

#. Key:	Rafi01Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1358)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1358)
msgctxt "MishpachaGreybox,Rafi01Desc"
msgid "A stall owner in the Old Yafeh market stopped paying. Remind him who runs this city."
msgstr "בעל דוכן בשוק יפה העתיקה הפסיק לשלם. תזכיר לו מי מנהל את העיר."

#. Key:	Rafi01A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1360)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1360)
msgctxt "MishpachaGreybox,Rafi01A"
msgid "Go to the market (yellow pillar near the beach)"
msgstr "לך לשוק (העמוד הצהוב ליד החוף)"

#. Key:	Rafi01ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1361)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1361)
msgctxt "MishpachaGreybox,Rafi01ASay"
msgid "Three months Itzik hasn't paid. Today he pays for all three."
msgstr "שלושה חודשים איציק לא שילם. היום הוא משלם על שלושתם."

#. Key:	Rafi01B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1362)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1362)
msgctxt "MishpachaGreybox,Rafi01B"
msgid "If the cops are on you, lose them"
msgstr "אם השוטרים עליך, תתחמק מהם"

#. Key:	Rafi02Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1365)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1365)
msgctxt "MishpachaGreybox,Rafi02Title"
msgid "Rival Crew"
msgstr "כנופיה יריבה"

#. Key:	Rafi02Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1366)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1366)
msgctxt "MishpachaGreybox,Rafi02Desc"
msgid "Some crew from out of town set up shop at Moshe's garage. On our street."
msgstr "איזה צוות מחוץ לעיר התמקם במוסך של משה. ברחוב שלנו."

#. Key:	Rafi02A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1369)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1369)
msgctxt "MishpachaGreybox,Rafi02A"
msgid "Drive to Moshe's garage"
msgstr "סע למוסך של משה"

#. Key:	Rafi02ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1370)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1370)
msgctxt "MishpachaGreybox,Rafi02ASay"
msgid "Moshe called. Strangers in his garage, and they're not there for an oil change."
msgstr "משה התקשר. זרים במוסך שלו, והם לא באו להחליף שמן."

#. Key:	Rafi02B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1371)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1371)
msgctxt "MishpachaGreybox,Rafi02B"
msgid "Take out the rival crew (press Q to call the boys)"
msgstr "חסל את הכנופיה (Q כדי לקרוא לחבר'ה)"

#. Key:	Rafi02BSay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1372)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1372)
msgctxt "MishpachaGreybox,Rafi02BSay"
msgid "Nobody does business in Tel Avir without asking the Sela family."
msgstr "אף אחד לא עושה עסקים בתל אויר בלי לשאול את משפחת סלע."

#. Key:	Rafi02C
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1373)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1373)
msgctxt "MishpachaGreybox,Rafi02C"
msgid "Lose the police"
msgstr "תתחמק מהמשטרה"

#. Key:	Shira01Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1377)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1377)
msgctxt "MishpachaGreybox,Shira01Title"
msgid "Dad's Phone"
msgstr "הטלפון של אבא"

#. Key:	Shira01Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1378)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1378)
msgctxt "MishpachaGreybox,Shira01Desc"
msgid "Dad's phone is sitting in the police evidence warehouse. Get it out before they unlock it."
msgstr "הטלפון של אבא נמצא במחסן המוצגים של המשטרה. צריך להוציא אותו לפני שיפרצו אותו."

#. Key:	Shira01A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1380)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1380)
msgctxt "MishpachaGreybox,Shira01A"
msgid "Get to the evidence warehouse"
msgstr "הגיעי למחסן המוצגים"

#. Key:	Shira01ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1381)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1381)
msgctxt "MishpachaGreybox,Shira01ASay"
msgid "If they read what's on that phone, all three of us go down. Me first."
msgstr "אם יקראו מה יש בטלפון הזה, שלושתנו נופלים. אני ראשונה."

#. Key:	Shira01B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1382)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1382)
msgctxt "MishpachaGreybox,Shira01B"
msgid "Grab a car"
msgstr "תשיגי רכב"

#. Key:	Shira01C
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1383)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1383)
msgctxt "MishpachaGreybox,Shira01C"
msgid "Bring the phone to the family drop-off"
msgstr "הביאי את הטלפון לנקודת האיסוף של המשפחה"

#. Key:	Shira02Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1386)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1386)
msgctxt "MishpachaGreybox,Shira02Title"
msgid "The Witness"
msgstr "העד"

#. Key:	Shira02Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1387)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1387)
msgctxt "MishpachaGreybox,Shira02Desc"
msgid "A witness against the family is at the hospital. Shira wants to talk to him before the prosecutor does."
msgstr "עד נגד המשפחה שוכב בבית החולים. שירה רוצה לדבר איתו לפני הפרקליטות."

#. Key:	Shira02A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1390)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1390)
msgctxt "MishpachaGreybox,Shira02A"
msgid "Go to the hospital"
msgstr "סעי לבית החולים"

#. Key:	Shira02ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1391)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1391)
msgctxt "MishpachaGreybox,Shira02ASay"
msgid "I'm his lawyer as of this morning. He just doesn't know it yet."
msgstr "מהבוקר אני עורכת הדין שלו. הוא פשוט עוד לא יודע."

#. Key:	Shira02B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1392)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1392)
msgctxt "MishpachaGreybox,Shira02B"
msgid "Talk to the witness (stay close)"
msgstr "דברי עם העד (הישארי קרוב)"

#. Key:	Shira02BSay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1393)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1393)
msgctxt "MishpachaGreybox,Shira02BSay"
msgid "Nobody's asking you to lie. Just to remember a little less."
msgstr "אף אחד לא מבקש ממך לשקר. רק לזכור קצת פחות."

#. Key:	Shira02C
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1394)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1394)
msgctxt "MishpachaGreybox,Shira02C"
msgid "Get a car"
msgstr "תשיגי רכב"

#. Key:	Shira02D
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1395)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1395)
msgctxt "MishpachaGreybox,Shira02D"
msgid "Take him somewhere quiet (the family drop-off)"
msgstr "קחי אותו למקום שקט (נקודת האיסוף)"

#. Key:	Shira02DSay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1396)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1396)
msgctxt "MishpachaGreybox,Shira02DSay"
msgid "Seatbelt. You're no use to anyone dead."
msgstr "חגורה. מת אתה לא שווה כלום לאף אחד."

#. Key:	Omer01Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1400)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1400)
msgctxt "MishpachaGreybox,Omer01Title"
msgid "Last Delivery"
msgstr "משלוח אחרון"

#. Key:	Omer01Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1401)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1401)
msgctxt "MishpachaGreybox,Omer01Desc"
msgid "One last package for the family before the big trip. What could go wrong?"
msgstr "חבילה אחרונה למשפחה לפני הטיול הגדול. מה כבר יכול להשתבש?"

#. Key:	Omer01A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1403)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1403)
msgctxt "MishpachaGreybox,Omer01A"
msgid "Get a ride"
msgstr "תשיג טרמפ"

#. Key:	Omer01ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1404)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1404)
msgctxt "MishpachaGreybox,Omer01ASay"
msgid "Rafi says it's just shoes. Nobody wraps shoes like this."
msgstr "רפי אומר שזה סתם נעליים. אף אחד לא עוטף נעליים ככה."

#. Key:	Omer01B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1405)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1405)
msgctxt "MishpachaGreybox,Omer01B"
msgid "Deliver the package to Moshe's garage"
msgstr "תמסור את החבילה במוסך של משה"

#. Key:	Omer01C
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1406)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1406)
msgctxt "MishpachaGreybox,Omer01C"
msgid "Lose anyone following you"
msgstr "תתחמק ממי שעוקב אחריך"

#. Key:	Omer02Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1409)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1409)
msgctxt "MishpachaGreybox,Omer02Title"
msgid "Eye in the Sky"
msgstr "עין בשמיים"

#. Key:	Omer02Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1410)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1410)
msgctxt "MishpachaGreybox,Omer02Desc"
msgid "The warehouse has new guards, and they aren't police. Omer gets a look from above first."
msgstr "במחסן יש שומרים חדשים, והם לא שוטרים. עומר מסתכל מלמעלה קודם."

#. Key:	Omer02A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1413)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1413)
msgctxt "MishpachaGreybox,Omer02A"
msgid "Go to the evidence warehouse"
msgstr "סע למחסן המוצגים"

#. Key:	Omer02ASay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1414)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1414)
msgctxt "MishpachaGreybox,Omer02ASay"
msgid "Two years in the drone unit. Finally useful for something."
msgstr "שנתיים ביחידת הרחפנים. סוף סוף זה שווה משהו."

#. Key:	Omer02B
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1415)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1415)
msgctxt "MishpachaGreybox,Omer02B"
msgid "Take out the guards (press Q: the drone marks them)"
msgstr "חסל את השומרים (Q: הרחפן מסמן אותם)"

#. Key:	Omer02BSay
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1416)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1416)
msgctxt "MishpachaGreybox,Omer02BSay"
msgid "Three on the ground. They haven't seen me. Yet."
msgstr "שלושה על הקרקע. הם לא ראו אותי. עדיין."

#. Key:	Omer02C
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1417)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1417)
msgctxt "MishpachaGreybox,Omer02C"
msgid "Lose the police"
msgstr "תתחמק מהמשטרה"

#. Key:	Family01Title
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1421)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1421)
msgctxt "MishpachaGreybox,Family01Title"
msgid "The Handover"
msgstr "ההעברה"

#. Key:	Family01Desc
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1422)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1422)
msgctxt "MishpachaGreybox,Family01Desc"
msgid "Rafi has the money. Shira has the judge. They need to meet without anyone seeing them together."
msgstr "לרפי יש את הכסף. לשירה יש את השופט. הם צריכים להיפגש בלי שאף אחד יראה אותם יחד."

#. Key:	Family01A
#. SourceLocation:	Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1427)
#: Source/Mishpacha/Private/World/CityGreyboxGenerator.cpp(1427)
msgctxt "MishpachaGreybox,Family01A"
msgid "Rafi: leave the envelope at the market"
msgstr "רפי: תשאיר את המעטפה בשוק"

